# SQLite database
DATABASE_URL="file:./dev.db"

# DeepSeek AI Tutor
# Replace this placeholder in your local .env file
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# AI Tutor settings
AI_TUTOR_ENABLED=true
AI_TUTOR_USER_DAILY_LIMIT=12
AI_TUTOR_GLOBAL_DAILY_LIMIT=120
